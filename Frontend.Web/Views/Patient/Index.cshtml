@model IEnumerable<Frontend.Web.Models.PatientDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Patients</h2>
    @if (Frontend.Web.Helpers.JwtSessionHelper.CanManagePatients(
            Context.Session.GetString("JWT") ?? ""))
    {
        <a asp-action="Create" class="btn btn-success">+ New Patient</a>
    }
</div>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Birth date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.FirstName</td>
                <td>@p.LastName</td>
                <td>@p.BirthDate.ToShortDateString()</td>
                <td>
                    @if (Frontend.Web.Helpers.JwtSessionHelper.CanManagePatients(
                            Context.Session.GetString("JWT") ?? ""))
                    {
                        <a asp-action="Edit" asp-route-id="@p.Id"
                           class="btn btn-sm btn-primary">Edit</a>
                    }
                    <a asp-action="Details" asp-route-id="@p.Id"
                       class="btn btn-sm btn-warning">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>