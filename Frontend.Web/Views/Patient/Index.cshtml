@model List<Frontend.Web.Models.PatientDto>

<h2>Patients</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Birth date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.FirstName</td>
                <td>@p.LastName</td>
                <td>@p.BirthDate.ToShortDateString()</td>

                <td>
                    <a asp-controller="Patient"
                       asp-action="Edit"
                       asp-route-id="@p.Id"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    <a asp-controller="Patient"
                       asp-action="Details"
                       asp-route-id="@p.Id"
                       class="btn btn-warning">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>