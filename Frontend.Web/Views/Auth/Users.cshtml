@model List<Frontend.Web.Models.UserDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>User Accounts</h2>
    <a asp-action="Register" class="btn btn-success">+ New User</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No user accounts found.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-secondary">@user.Role</span></td>
                    <td>
                        <a asp-action="EditUser" asp-route-id="@user.Id"
                           class="btn btn-sm btn-primary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}